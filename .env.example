# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>.mongodb.net/hotel_kubera?retryWrites=true&w=majority

# Admin Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_random_jwt_secret_key

# Restaurant Meta
RESTAURANT_NAME="Hotel Kubera"
RESTAURANT_CITY="Eluru"
RESTAURANT_TAGLINE="Taste the Wealth of Flavours"
GST_PERCENTAGE=5
